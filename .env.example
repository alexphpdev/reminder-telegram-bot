# Docker Compose runtime user mapping for bind mounts.
# Set these to the UID/GID of the host user that owns the checkout.
# Local example:
#   HOST_UID=1000
#   HOST_GID=1000
# Server example:
#   use the deploy/runtime user that owns the repo checkout.
# Compose applies them as `user: UID:GID` for `app`, `scheduler`, and `poller`.
HOST_UID=1000
HOST_GID=1000
